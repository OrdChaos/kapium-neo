---
import { siteConfig } from '@/config/site';

const { statusUrl, icp, mps } = siteConfig.footer;

const ICP_URL = 'https://beian.miit.gov.cn/';
const MPS_URL = 'https://beian.mps.gov.cn/#/';
const MPS_ICON = '/img/icons/gongan.png';

const showIcp = icp.enabled && Boolean(icp.text);
const showMps = mps.enabled && Boolean(mps.text);
---

<footer data-site-footer class="border-border/90 bg-background border-t" aria-label="页脚信息">
  <div class="container mx-auto px-4 py-8">
    <div
      class="text-muted-foreground flex flex-col items-center justify-between gap-4 text-center md:flex-row md:items-start md:text-left"
    >
      <div class="flex flex-col gap-2">
        <p class="text-sm leading-5">
          {'©'}
          <span data-current-year></span>
          <a
            href="/"
            class="text-foreground/90 hover:text-primary font-medium transition-colors duration-300"
          >
            {` ${siteConfig.title}`}
          </a>
          {' - 保留一切权利'}
        </p>
        <p class="text-xs leading-5">
          {'由 '}
          <a
            href="https://astro.build"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-primary transition-colors duration-300"
          >
            Astro
          </a>
          {' & '}
          <a
            href="https://github.com/ordchaos/kapium-neo"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-primary transition-colors duration-300"
          >
            Kapium-Neo
          </a>
          {' 构建'}
        </p>
      </div>

      <div class="flex flex-col items-center gap-2 md:items-end md:text-right">
        <nav
          class="flex flex-wrap items-center justify-center gap-x-1 gap-y-1 text-sm leading-5 md:justify-end"
        >
          <a href="/copyright-policy/" class="hover:text-primary transition-colors duration-300">
            版权政策
          </a>
          <span class="opacity-35">·</span>
          <a href="/cookies-policy/" class="hover:text-primary transition-colors duration-300">
            Cookies 政策
          </a>
          <span class="opacity-35">·</span>
          <a href="/privacy-policy/" class="hover:text-primary transition-colors duration-300">
            隐私政策
          </a>
          {
            statusUrl && (
              <>
                <span class="opacity-35">·</span>
                <a
                  href={statusUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-primary transition-colors duration-300"
                >
                  服务监控
                </a>
              </>
            )
          }
        </nav>

        <div
          class="flex flex-wrap items-center justify-center gap-x-1 gap-y-1 text-xs leading-5 md:justify-end"
        >
          {
            showIcp && (
              <a
                href={ICP_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-primary inline-flex items-center transition-colors duration-300"
              >
                {icp.text}
              </a>
            )
          }
          {showIcp && showMps && <span class="hidden opacity-35 sm:inline">·</span>}
          {
            showMps && (
              <a
                href={MPS_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="group hover:text-primary inline-flex items-center gap-1.5 transition-colors duration-300"
              >
                <img
                  src={MPS_ICON}
                  alt="公安备案图标"
                  width="14"
                  height="14"
                  class="size-3.5 object-contain opacity-75 saturate-75 transition-all duration-300 group-hover:opacity-100 group-hover:saturate-100"
                />
                <span>{mps.text}</span>
              </a>
            )
          }
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  function initFooter() {
    const yearEl = document.querySelector('[data-site-footer] [data-current-year]');
    if (yearEl) {
      yearEl.textContent = String(new Date().getFullYear());
    }
  }

  document.addEventListener('astro:page-load', initFooter);
  initFooter();
</script>
