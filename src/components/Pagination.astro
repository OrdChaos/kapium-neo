---
import Tooltip from '@/components/ui/tooltip.astro';
import Ellipsis from '@lucide/astro/icons/ellipsis';
import CornerDownLeft from '@lucide/astro/icons/corner-down-left';
import { buildPageSlots, pageHref } from '@/lib/pagination';

interface Props {
  currentPage: number;
  totalPages: number;
  class?: string;
}

const { currentPage, totalPages, class: className } = Astro.props;

const visible = totalPages > 1;
const desktopSlots = buildPageSlots(currentPage, totalPages, 2);
const mobileSlots = buildPageSlots(currentPage, totalPages, 1);

const buttonBase =
  'inline-flex items-center justify-center rounded-md border text-sm tabular-nums select-none transition-all duration-300';
const buttonCurrent =
  'bg-primary text-primary-foreground border-primary font-medium cursor-default';
const buttonSize = 'h-10 min-w-10 px-3';
const buttonIdle =
  'bg-card border-border text-foreground hover:border-primary/50 hover:bg-muted/50 active:scale-[0.98] cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50';
---

{
  visible && (
    <div
      class:list={[
        'mt-12 flex flex-col items-center gap-3 sm:flex-row sm:flex-wrap sm:justify-center sm:gap-2',
        className,
      ]}
    >
      {/* 移动端：页码单行（当前页 ±1） */}
      <nav class="flex items-center gap-1 sm:hidden" aria-label="分页">
        {mobileSlots.map((slot) =>
          slot === 'ellipsis' ? (
            <span
              class="text-muted-foreground inline-flex h-10 w-7 items-center justify-center select-none"
              aria-hidden="true"
            >
              <Ellipsis class="h-4 w-4" />
            </span>
          ) : (
            <a
              href={pageHref(slot)}
              aria-current={slot === currentPage ? 'page' : undefined}
              class:list={[
                buttonBase,
                buttonSize,
                slot === currentPage ? buttonCurrent : buttonIdle,
              ]}
            >
              {slot}
            </a>
          ),
        )}
      </nav>

      {/* 桌面端：页码单行（当前页 ±2） */}
      <nav class="hidden items-center gap-2 sm:flex" aria-label="分页">
        {desktopSlots.map((slot) =>
          slot === 'ellipsis' ? (
            <span
              class="text-muted-foreground inline-flex h-10 w-7 items-center justify-center select-none"
              aria-hidden="true"
            >
              <Ellipsis class="h-4 w-4" />
            </span>
          ) : (
            <a
              href={pageHref(slot)}
              aria-current={slot === currentPage ? 'page' : undefined}
              class:list={[
                buttonBase,
                buttonSize,
                slot === currentPage ? buttonCurrent : buttonIdle,
              ]}
            >
              {slot}
            </a>
          ),
        )}
      </nav>

      {/* 输入跳转 */}
      <form
        data-pagination-jump
        data-current={currentPage}
        data-total={totalPages}
        aria-label="跳转页码"
        novalidate
        class="border-border bg-card hover:border-primary/50 focus-within:border-primary/60 focus-within:ring-ring/30 flex h-10 items-center rounded-md border text-sm transition-all duration-300 focus-within:ring-2"
      >
        <input
          data-pagination-input
          type="number"
          inputmode="numeric"
          min="1"
          max={totalPages}
          placeholder="页码"
          aria-label="输入页码"
          class="h-full w-16 rounded-l-md bg-transparent px-2 text-center text-sm tabular-nums outline-none [-moz-appearance:textfield] sm:w-14 [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
        />
        <Tooltip label="前往指定页">
          <button
            type="submit"
            aria-label="前往指定页"
            class="border-border text-muted-foreground hover:text-foreground hover:bg-muted/50 inline-flex h-10 w-10 items-center justify-center rounded-r-md border-l transition-colors duration-300 active:scale-[0.98]"
          >
            <CornerDownLeft class="h-4 w-4" />
          </button>
        </Tooltip>
      </form>
    </div>
  )
}

<script>
  import { navigate } from 'astro:transitions/client';

  function initPagination() {
    const form = document.querySelector<HTMLFormElement>('[data-pagination-jump]');
    if (!form || form.dataset.bound === '1') return;
    form.dataset.bound = '1';

    const input = form.querySelector<HTMLInputElement>('[data-pagination-input]');
    if (!input) return;

    const currentPage = Number(form.dataset.current ?? '1');
    const totalPages = Number(form.dataset.total ?? '1');

    const jump = () => {
      const raw = input.value.trim();
      const value = Number(raw);

      if (!raw || !Number.isFinite(value)) {
        input.focus();
        return;
      }

      const target = Math.min(Math.max(Math.trunc(value), 1), totalPages);
      input.value = '';

      if (target === currentPage) {
        input.blur();
        return;
      }

      navigate(target === 1 ? '/' : `/page/${target}/`);
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      jump();
    });
  }

  document.addEventListener('astro:page-load', initPagination);
  initPagination();
</script>
